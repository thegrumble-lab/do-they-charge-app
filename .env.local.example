# Copy this file to .env.local and fill in your Supabase project's values
# (Project Settings -> API in the Supabase dashboard). Never commit the
# real .env.local — it's already gitignored.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Required for search (see HANDOFF.md, "Search latency — bypassing
# PostgREST"). This is the Postgres connection-pooler string from Supabase
# Project Settings -> Database -> Connection string -> Session pooler (or
# Transaction pooler) -- NOT the API URL above. It contains your actual
# database password, not the anon key, so treat it with extra care.
DATABASE_URL=postgres://postgres.your-project-ref:your-db-password@aws-0-eu-west-2.pooler.supabase.com:5432/postgres

# Optional — error monitoring (see HANDOFF.md, "Error monitoring"). The
# whole Sentry integration is inert with these unset, so it's fine to
# leave them out entirely for local dev.
# NEXT_PUBLIC_SENTRY_DSN=https://xxxx@oXXXXXX.ingest.sentry.io/XXXXXXX
# SENTRY_DSN=https://xxxx@oXXXXXX.ingest.sentry.io/XXXXXXX
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=your-project-slug
# SENTRY_AUTH_TOKEN=only-needed-in-ci-for-source-map-uploads
