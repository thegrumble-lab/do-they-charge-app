# Copy this file to .env.local and fill in your Supabase project's values
# (Project Settings -> API in the Supabase dashboard). Never commit the
# real .env.local — it's already gitignored.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Required for search and the sitemaps (see HANDOFF.md, "Full outage ...
# then bypassing PostgREST entirely"). This is the Postgres connection
# string from Supabase: Project Settings -> Database -> Connect ->
# Transaction pooler, with "Use IPv4 connection" turned ON (Vercel's
# functions can't reach the IPv6-only dedicated pooler). It is NOT the API
# URL above, and it contains your real database password rather than the
# publishable anon key, so treat it accordingly. Note port 6543 — that's
# the transaction pooler; 5432 on the same host is the session pooler.
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-eu-west-2.pooler.supabase.com:6543/postgres

# Required for /admin (correcting reports, working through flagged
# entries). A single shared password — there are no user accounts. Pick a
# long random one: it's the only thing standing between the internet and
# your edit tools. Leaving it unset disables admin sign-in entirely, which
# is the right setting for any deployment that shouldn't have one.
ADMIN_PASSWORD=a-long-random-string-you-generate

# Optional — error monitoring (see HANDOFF.md, "Error monitoring"). The
# whole Sentry integration is inert with these unset, so it's fine to
# leave them out entirely for local dev.
# NEXT_PUBLIC_SENTRY_DSN=https://xxxx@oXXXXXX.ingest.sentry.io/XXXXXXX
# SENTRY_DSN=https://xxxx@oXXXXXX.ingest.sentry.io/XXXXXXX
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=your-project-slug
# SENTRY_AUTH_TOKEN=only-needed-in-ci-for-source-map-uploads
